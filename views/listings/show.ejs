<% layout("/layouts/boilerplate") %>
<% const defaultImageUrl = "https://images.unsplash.com/photo-1570129477492-45c003edd2be?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"; %>
<% const imageUrl = listing.image && listing.image.url ? listing.image.url : defaultImageUrl; %>
<% const displayPrice = Number(listing.price || 0).toLocaleString("en-IN"); %>
    <div class="container show-page-wrapper">

        <div class="breadcrumb-custom">
            <a href="/listings">All Listings</a> <i class="fa-solid fa-chevron-right mx-1" style="font-size:0.7rem;"></i> <%= listing.title %>
        </div>

        <div class="row g-4">
            <!-- left side: image -->
            <div class="col-lg-7">
                <div class="show-image-wrapper">
                    <img src="<%= imageUrl %>" class="show-image" alt="<%= listing.title %>">
                </div>
            </div>

            <!-- right side: details -->
            <div class="col-lg-5">
                <h1 class="show-title"><%= listing.title %></h1>
                <p class="show-location">
                    <i class="fa-solid fa-location-dot"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>

                <div class="show-price-tag">
                    &#8377; <%= displayPrice %> <span class="per-night">/ night</span>
                </div>
                <p>owned by: <%= listing.owner.username %></p>
                <p class="show-description"><%= listing.description %></p>

                <ul class="detail-list">
                    <li><i class="fa-solid fa-location-dot"></i> <span class="detail-label">Location</span> <%= listing.location %></li>
                    <li><i class="fa-solid fa-earth-americas"></i> <span class="detail-label">Country</span> <%= listing.country %></li>
                    <li><i class="fa-solid fa-indian-rupee-sign"></i> <span class="detail-label">Price</span> &#8377; <%= displayPrice %> / night</li>
                </ul>
                 <%  if(currUser && currUser._id.equals(listing.owner._id)) { %>
                <div class="show-action-btn">
                    <a href="/listings/<%= listing._id %>/edit" class="btn-outline-custom">
                        <i class="fa-regular fa-pen-to-square me-1"></i> Edit Listing
                    </a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn-danger-custom" onclick="return confirm('Are you sure you want to delete this listing?');">
                            <i class="fa-regular fa-trash-can me-1"></i> Delete Listing
                        </button>
                    </form>
                </div>
                <%  } %> 
            </div>
        </div>

        <% if(currUser) {%>
        <div>
            <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%=listing.id%>/reviews" method="post">
                <div>
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min = "1" max = "5" id="rating" name="review[rating]"
                    class="form-range">
                </div>
                <div>
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="15" class="form-control" required></textarea>
                    <div class="invalid-feedback">please add some review!</div>
                </div>
                <br>
                <button class="btn">submit</button>
            </form>
            <hr>
        <% } %>
            <h4>All Reviews</h4>
            <div class="row">
            <% for(review of listing.reviews) { %>
                <div class="card col-5 mb-3 me-3">
                    <div class="card-body">
                        <h5 class="card-title">John Doe</h5>
                        <p class="card-text"><%= review.comment%></p>
                        <p class="card-rating">Rating: <%= review.rating%></p>
                    </div>
                    <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button class="btn mb-2">Delete</button>
                    </form>
                </div>
            <% } %>
            </div>
            
        </div>
    

    </div>
