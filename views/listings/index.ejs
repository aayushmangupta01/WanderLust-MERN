<% layout("/layouts/boilerplate") %>
<% const defaultImageUrl = "https://images.unsplash.com/photo-1570129477492-45c003edd2be?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"; %>


    <!-- HERO / SEARCH SECTION -->
    <section class="hero">
        <h1>Find your next stay</h1>
        <p>Unique homes, breathtaking views, unforgettable trips.</p>
        <form class="filter-bar" action="/listings" method="get">
            <i class="fa-solid fa-magnifying-glass text-coyote ms-2"></i>
            <input type="text" name="search" placeholder="Search destinations, cities, countries...">
            <button type="submit" class="btn">Search</button>
        </form>
    </section>

    <div class="container">

        <!-- FILTER CHIPS -->
        <div class="filter-chips">
            <div class="filter-chip active"><i class="fa-solid fa-border-all me-1"></i> All</div>
            <div class="filter-chip"><i class="fa-solid fa-mountain-sun me-1"></i> Trending</div>
            <div class="filter-chip"><i class="fa-solid fa-tree me-1"></i> Cabins</div>
            <div class="filter-chip"><i class="fa-solid fa-water me-1"></i> Beachfront</div>
            <div class="filter-chip"><i class="fa-solid fa-city me-1"></i> Cities</div>
            <div class="filter-chip"><i class="fa-solid fa-snowflake me-1"></i> Arctic</div>
            <div class="filter-chip"><i class="fa-solid fa-spa me-1"></i> Luxury</div>
            <div class="filter-chip"><i class="fa-solid fa-campground me-1"></i> Camping</div>
        </div>

        <h2 class="section-heading">All Listings</h2>

        <% if (allListings && allListings.length > 0) { %>
            <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4 pb-5">
               <% for(let listing of allListings) { %>
                    <% const imageUrl = listing.image && listing.image.url ? listing.image.url : defaultImageUrl; %>
                    <% const displayPrice = Number(listing.price || 0).toLocaleString("en-IN"); %>
                    <a href="/listings/<%= listing._id %>" class="listing-link col">
                        <div class="card h-100">
                            <div class="card-img-wrapper">
                                <img src="<%= imageUrl %>" class="card-img-top" alt="<%= listing.title %>">
                                <div class="card-img-overlay">
                                    <span><i class="fa-regular fa-eye me-1"></i> View details</span>
                                </div>
                                <div class="price-badge">&#8377; <%= displayPrice %></div>
                            </div>
                            <div class="card-body">
                                <p class="card-title-text"><%= listing.title %></p>
                                <p class="card-location-text"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></p>
                                <p class="card-price">&#8377; <%= displayPrice %> <span class="per-night">/ night</span></p>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="fa-regular fa-compass"></i>
                <h4>No listings found</h4>
                <p>Try adjusting your search or check back later.</p>
                <a href="/listings/new" class="btn mt-2">Add a Listing</a>
            </div>
        <% } %>

    </div>
